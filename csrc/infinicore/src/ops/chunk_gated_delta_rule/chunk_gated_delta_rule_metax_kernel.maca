
#include <cstddef>
#include <cstdint>
#include "chunk_gated_delta_rule_metax_launch.h"
#include "chunk_gated_delta_rule_kernel_common.cuh"

namespace {

template <typename Tdata, typename Tgate, size_t Dk, size_t Dv, size_t NUM_THREADS>
__global__ void chunk_gated_delta_rule_fast_kernel(
    float *state_workspace,
    Tdata *out,
    Tdata *initial_state,
    Tdata *final_state,
    const Tdata *q,
    const Tdata *k,
    const Tdata *v,
    const Tgate *g,
    const Tgate *beta,
    const void *cu_seqlens,
    const void *initial_state_indices,
    const void *final_state_indices,
    bool cu_seqlens_i64,
    bool initial_state_indices_i64,
    bool final_state_indices_i64,
    bool use_qk_l2norm,
    bool has_cu_seqlens,
    bool indexed_state_pool,
    size_t T,
    size_t chunk_size,
    size_t pool_size,
    size_t Hk,
    size_t value_heads_per_key_head,
    ptrdiff_t out_s0, ptrdiff_t out_s1, ptrdiff_t out_s2,
    ptrdiff_t initial_s0, ptrdiff_t initial_s1, ptrdiff_t initial_s2, ptrdiff_t initial_s3,
    ptrdiff_t final_s0, ptrdiff_t final_s1, ptrdiff_t final_s2, ptrdiff_t final_s3,
    ptrdiff_t q_s0, ptrdiff_t q_s1, ptrdiff_t q_s2,
    ptrdiff_t k_s0, ptrdiff_t k_s1, ptrdiff_t k_s2,
    ptrdiff_t v_s0, ptrdiff_t v_s1, ptrdiff_t v_s2,
    ptrdiff_t g_s0, ptrdiff_t g_s1, ptrdiff_t g_s2,
    ptrdiff_t beta_s0, ptrdiff_t beta_s1, ptrdiff_t beta_s2) {
	chunkGatedDeltaRuleRecurrentKernel<Tdata, Tgate, float, Dk, Dv, NUM_THREADS>(
	    state_workspace, out, initial_state, final_state, q, k, v, g, beta, cu_seqlens,
	    initial_state_indices, final_state_indices, cu_seqlens_i64,
	    initial_state_indices_i64, final_state_indices_i64, use_qk_l2norm,
	    has_cu_seqlens, indexed_state_pool, T, chunk_size, pool_size, Hk, value_heads_per_key_head,
	    out_s0, out_s1, out_s2, initial_s0, initial_s1, initial_s2, initial_s3,
	    final_s0, final_s1, final_s2, final_s3, q_s0, q_s1, q_s2, k_s0, k_s1, k_s2,
	    v_s0, v_s1, v_s2, g_s0, g_s1, g_s2, beta_s0, beta_s1, beta_s2);
}

template <typename Tdata, typename Tgate, size_t Dk, size_t Dv, size_t NUM_THREADS>
int launch_typed(const InfiniLMChunkGatedLaunchArgs *a) {
	dim3 grid(static_cast<unsigned>(a->B), static_cast<unsigned>(a->Hv), 1);
	dim3 block(static_cast<unsigned>(NUM_THREADS));
	mcStream_t stream = reinterpret_cast<mcStream_t>(a->stream);
	size_t shmem = (Dk + Dk + NUM_THREADS) * sizeof(float);
	chunk_gated_delta_rule_fast_kernel<Tdata, Tgate, Dk, Dv, NUM_THREADS>
	    <<<grid, block, shmem, stream>>>(
	        static_cast<float *>(a->workspace),
	        static_cast<Tdata *>(a->out),
	        static_cast<Tdata *>(a->initial_state),
	        static_cast<Tdata *>(a->final_state),
	        static_cast<const Tdata *>(a->q),
	        static_cast<const Tdata *>(a->k),
	        static_cast<const Tdata *>(a->v),
	        static_cast<const Tgate *>(a->g),
	        static_cast<const Tgate *>(a->beta),
	        a->cu_seqlens,
	        a->initial_state_indices,
	        a->final_state_indices,
	        a->cu_seqlens_i64 != 0,
	        a->initial_state_indices_i64 != 0,
	        a->final_state_indices_i64 != 0,
	        a->use_qk_l2norm != 0,
	        a->has_cu_seqlens != 0,
	        a->indexed_state_pool != 0,
	        static_cast<size_t>(a->T),
	        static_cast<size_t>(a->chunk_size),
	        static_cast<size_t>(a->pool_size),
	        static_cast<size_t>(a->Hk),
	        static_cast<size_t>(a->value_heads_per_key_head),
	        a->out_s0, a->out_s1, a->out_s2,
	        a->initial_s0, a->initial_s1, a->initial_s2, a->initial_s3,
	        a->final_s0, a->final_s1, a->final_s2, a->final_s3,
	        a->q_s0, a->q_s1, a->q_s2,
	        a->k_s0, a->k_s1, a->k_s2,
	        a->v_s0, a->v_s1, a->v_s2,
	        a->g_s0, a->g_s1, a->g_s2,
	        a->beta_s0, a->beta_s1, a->beta_s2);
	return static_cast<int>(mcGetLastError());
}

template <typename Tdata, size_t Dk, size_t Dv, size_t NUM_THREADS>
int launch_gate(const InfiniLMChunkGatedLaunchArgs *a) {
	switch (a->gate_dtype) {
	case 0: return launch_typed<Tdata, float, Dk, Dv, NUM_THREADS>(a);
	case 1: return launch_typed<Tdata, __half, Dk, Dv, NUM_THREADS>(a);
	case 2: return launch_typed<Tdata, __maca_bfloat16, Dk, Dv, NUM_THREADS>(a);
	default: return 3;
	}
}

template <size_t Dk, size_t Dv, size_t NUM_THREADS>
int launch_data(const InfiniLMChunkGatedLaunchArgs *a) {
	switch (a->dtype) {
	case 0: return launch_gate<float, Dk, Dv, NUM_THREADS>(a);
	case 1: return launch_gate<__half, Dk, Dv, NUM_THREADS>(a);
	case 2: return launch_gate<__maca_bfloat16, Dk, Dv, NUM_THREADS>(a);
	default: return 2;
	}
}

} // namespace

extern "C" int infinilm_chunk_gated_delta_rule_metax_launch(const InfiniLMChunkGatedLaunchArgs *args) {
	if (args == nullptr || args->out == nullptr || args->initial_state == nullptr ||
	    args->q == nullptr || args->k == nullptr || args->v == nullptr ||
	    args->g == nullptr || args->beta == nullptr || args->workspace == nullptr) {
		return 1;
	}
	if (args->Dk == 128 && args->Dv == 128) {
		return launch_data<128, 128, 128>(args);
	}
	if (args->Dk == 64 && args->Dv == 64) {
		return launch_data<64, 64, 64>(args);
	}
	return 4;
}
