
#include <cstddef>
#include <cstdint>
#include "recurrent_gated_delta_rule_metax_launch.h"
#include "recurrent_gated_delta_rule_kernel.cuh"

namespace {

template <typename Tdata, typename Tgate, size_t Dk, size_t Dv, size_t WARPS_PER_BLOCK>
__global__ void recurrent_gated_delta_rule_kernel(
    Tdata *out,
    Tdata *initial_state,
    Tdata *final_state,
    const Tdata *q,
    const Tdata *k,
    const Tdata *v,
    const Tgate *g,
    const Tgate *beta,
    const void *initial_state_indices,
    const void *final_state_indices,
    bool initial_state_indices_i64,
    bool final_state_indices_i64,
    bool use_qk_l2norm,
    bool indexed_state_pool,
    size_t pool_size,
    size_t num_key_heads,
    size_t value_heads_per_key_head,
    ptrdiff_t out_s0, ptrdiff_t out_s1, ptrdiff_t out_s2,
    ptrdiff_t initial_s0, ptrdiff_t initial_s1, ptrdiff_t initial_s2, ptrdiff_t initial_s3,
    ptrdiff_t final_s0, ptrdiff_t final_s1, ptrdiff_t final_s2, ptrdiff_t final_s3,
    ptrdiff_t q_s0, ptrdiff_t q_s1, ptrdiff_t q_s2,
    ptrdiff_t k_s0, ptrdiff_t k_s1, ptrdiff_t k_s2,
    ptrdiff_t v_s0, ptrdiff_t v_s1, ptrdiff_t v_s2,
    ptrdiff_t g_s0, ptrdiff_t g_s1, ptrdiff_t g_s2,
    ptrdiff_t beta_s0, ptrdiff_t beta_s1, ptrdiff_t beta_s2) {
	extern __shared__ float shared[];
	recurrentGatedDeltaRuleIndexedPoolWarpKernel<Tdata, Tgate, float, Dk, Dv, WARPS_PER_BLOCK>(
	    out, initial_state, final_state, q, k, v, g, beta,
	    initial_state_indices, final_state_indices,
	    initial_state_indices_i64, final_state_indices_i64,
	    use_qk_l2norm, indexed_state_pool, pool_size, num_key_heads, value_heads_per_key_head,
	    out_s0, out_s1, out_s2,
	    initial_s0, initial_s1, initial_s2, initial_s3,
	    final_s0, final_s1, final_s2, final_s3,
	    q_s0, q_s1, q_s2, k_s0, k_s1, k_s2, v_s0, v_s1, v_s2,
	    g_s0, g_s1, g_s2, beta_s0, beta_s1, beta_s2,
	    shared);
}

template <typename Tdata, typename Tgate, size_t Dk, size_t Dv, size_t WARPS_PER_BLOCK>
int launch_typed(const InfiniLMRecurrentGatedLaunchArgs *a) {
	constexpr int WARP_SIZE = INFINIOP_RECURRENT_DELTA_RULE_WARP_SIZE;
	dim3 grid(static_cast<unsigned>(a->B),
	         static_cast<unsigned>(a->Hv),
	         static_cast<unsigned>((a->Dv + WARPS_PER_BLOCK - 1) / WARPS_PER_BLOCK));
	dim3 block(static_cast<unsigned>(WARPS_PER_BLOCK * WARP_SIZE));
	mcStream_t stream = reinterpret_cast<mcStream_t>(a->stream);
	// q/k/decay (3*Dk) + reduction scratch (NUM_THREADS) + beta scalar
	size_t shmem = (Dk * 3 + block.x + 1) * sizeof(float);
	recurrent_gated_delta_rule_kernel<Tdata, Tgate, Dk, Dv, WARPS_PER_BLOCK>
	    <<<grid, block, shmem, stream>>>(
	        static_cast<Tdata *>(a->out),
	        static_cast<Tdata *>(a->initial_state),
	        static_cast<Tdata *>(a->final_state),
	        static_cast<const Tdata *>(a->q),
	        static_cast<const Tdata *>(a->k),
	        static_cast<const Tdata *>(a->v),
	        static_cast<const Tgate *>(a->g),
	        static_cast<const Tgate *>(a->beta),
	        a->initial_state_indices,
	        a->final_state_indices,
	        a->initial_state_indices_i64 != 0,
	        a->final_state_indices_i64 != 0,
	        a->use_qk_l2norm != 0,
	        a->indexed_state_pool != 0,
	        static_cast<size_t>(a->pool_size),
	        static_cast<size_t>(a->Hk),
	        static_cast<size_t>(a->value_heads_per_key_head),
	        a->out_s0, a->out_s1, a->out_s2,
	        a->initial_s0, a->initial_s1, a->initial_s2, a->initial_s3,
	        a->final_s0, a->final_s1, a->final_s2, a->final_s3,
	        a->q_s0, a->q_s1, a->q_s2,
	        a->k_s0, a->k_s1, a->k_s2,
	        a->v_s0, a->v_s1, a->v_s2,
	        a->g_s0, a->g_s1, a->g_s2,
	        a->beta_s0, a->beta_s1, a->beta_s2);
	return static_cast<int>(mcGetLastError());
}

template <typename Tdata, size_t Dk, size_t Dv, size_t WARPS_PER_BLOCK>
int launch_gate(const InfiniLMRecurrentGatedLaunchArgs *a) {
	switch (a->gate_dtype) {
	case 0: return launch_typed<Tdata, float, Dk, Dv, WARPS_PER_BLOCK>(a);
	case 1: return launch_typed<Tdata, __half, Dk, Dv, WARPS_PER_BLOCK>(a);
	case 2: return launch_typed<Tdata, __maca_bfloat16, Dk, Dv, WARPS_PER_BLOCK>(a);
	default: return 3;
	}
}

template <size_t Dk, size_t Dv, size_t WARPS_PER_BLOCK>
int launch_data(const InfiniLMRecurrentGatedLaunchArgs *a) {
	switch (a->dtype) {
	case 0: return launch_gate<float, Dk, Dv, WARPS_PER_BLOCK>(a);
	case 1: return launch_gate<__half, Dk, Dv, WARPS_PER_BLOCK>(a);
	case 2: return launch_gate<__maca_bfloat16, Dk, Dv, WARPS_PER_BLOCK>(a);
	default: return 2;
	}
}

} // namespace

extern "C" int infinilm_recurrent_gated_delta_rule_metax_launch(const InfiniLMRecurrentGatedLaunchArgs *args) {
	if (args == nullptr || args->out == nullptr || args->initial_state == nullptr ||
	    args->q == nullptr || args->k == nullptr || args->v == nullptr ||
	    args->g == nullptr || args->beta == nullptr) {
		return 1;
	}
	if (args->Dk == 128 && args->Dv == 128) {
		return launch_data<128, 128, 8>(args);
	}
	if (args->Dk == 64 && args->Dv == 64) {
		return launch_data<64, 64, 8>(args);
	}
	return 4;
}
